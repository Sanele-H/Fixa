# Copy to .env (npm run setup does this for you). Never commit .env.

# Translation backend: echo (fake, no key needed) | add google, claude, nllb, lelapa as Role 1 builds them
TRANSLATION_BACKEND=echo
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=

# Photo -> trade suggester: keywords | claude (once Role 3 builds it)
TRADE_SUGGESTER=keywords

# Browser origins allowed to call the API directly. The Vite dev server proxies /api, so
# phones on the same Wi-Fi don't need to be listed here.
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (read by Vite, must start with VITE_)
# true = the frontend uses fake data from src/api/mockData.js, so Role 2 isn't blocked on the backend
VITE_USE_MOCK_API=true
