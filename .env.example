# Copy to .env (npm run setup does this). Never commit .env. When live, these go in the Render dashboard.
# One shared set of keys for the team.

# API (P2)
DATABASE_URL=sqlite:///./fixa.db
JWT_SECRET=change-me
DEMO_OTP=123456

# Translation and LLM tasks (P3)
# TRANSLATION_BACKEND: fake (no keys, for building), azure (live chat) or claude
TRANSLATION_BACKEND=fake
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=southafricanorth
ANTHROPIC_API_KEY=

# Identity: Smile ID sandbox (P2)
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENVIRONMENT=sandbox

# SMS and USSD: Africa's Talking sandbox (P2)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# Payments (P2). PAYMENT_PROVIDER: mock (test checkout, no keys) or payfast.
# PayFast sandbox details come from https://sandbox.payfast.co.za (free account, no business needed).
PAYMENT_PROVIDER=mock
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Where PayFast sends people back to, and where it posts its webhook. Needed live; locally the
# request's own address is used, which PayFast can't reach (use `npm run tunnel`).
PUBLIC_APP_URL=
PUBLIC_API_URL=

# Place names for pins on the job map (P2). GEOCODER: nominatim (OpenStreetMap, no key) or fake
# (nearest seed suburb, offline). Nominatim needs a User-Agent that says who is asking.
GEOCODER=nominatim
NOMINATIM_USER_AGENT=Fixa/0.1 (hackathon job marketplace; +https://fixa-2o94.onrender.com)

# Supabase Postgres and Storage (when live)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Web Push (P2 + P1)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# App (read by Vite; must start with VITE_)
VITE_USE_MSW=true
VITE_VAPID_PUBLIC_KEY=
